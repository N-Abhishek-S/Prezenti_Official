# Presenti Web - Frontend Environment

# First-party backend API used by the React app.
# Local development example:
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Optional override for the website chat endpoint.
# Leave empty unless the backend route is mounted somewhere non-standard.
VITE_CHAT_API_URL=

# Do not point production browser code directly at n8n localhost webhooks.
# If a direct n8n test is ever needed locally, use a separate local-only env file.
VITE_N8N_CHAT_WEBHOOK=


# Presenti Server - Core Environment

PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://user:password@localhost:5432/presenti
PRISMA_CONNECT_ON_BOOT=true
JWT_SECRET=replace-with-a-long-random-secret
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Comma-separated frontend origins allowed to call the first-party API.
# Add the deployed production domain here when deployed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# n8n Automation Webhooks

# Website chat workflow only. This workflow accepts website chat payloads:
# { message, service, location, propertyType, workType, sessionId }
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/ps-chat
N8N_CHAT_TIMEOUT_MS=20000

# WhatsApp workflow only. This must continue to process Meta WhatsApp webhook payloads.
N8N_WHATSAPP_WEBHOOK_URL=http://localhost:5678/webhook/ps-whatsapp


# External Automation Credentials

GEMINI_API_KEY=
WHATSAPP_TOKEN=
COMPANY_WHATSAPP_NUMBER=918788726752
GOOGLE_SHEET_ID=

# Optional for n8n Respond to Webhook CORS headers when testing direct n8n calls.
FRONTEND_ORIGIN=http://localhost:5173
