# Presenti Web - Frontend Environment

# First-party backend API used by the React app.
# Local development example:
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Presenti Server - Core Environment

PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://user:password@localhost:5432/presenti
PRISMA_CONNECT_ON_BOOT=true
JWT_SECRET=replace-with-a-long-random-secret
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Comma-separated frontend origins allowed to call the first-party API.
# Add the deployed production domain here when deployed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Inquiry Delivery - Backend Only

TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
SENIOR_WHATSAPP=whatsapp:+918788726752

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-gmail-address
SMTP_PASS=replace-with-gmail-app-password
MAIL_FROM=replace-with-from-address
MAIL_FROM_NAME=Prezenti
MAIL_TO=replace-with-admin-mailbox
