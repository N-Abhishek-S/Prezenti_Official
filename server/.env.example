# Presenti Server - Environment Configuration
# Copy this file to .env and fill in local or deployment values.

# Required: PostgreSQL database used by Prisma.
DATABASE_URL=postgresql://postgres:password@localhost:5432/presenti_db?schema=public

# Required: JWT signing secret used by the auth module.
JWT_SECRET=change-this-to-a-long-random-secret

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-if-refresh-tokens-are-enabled
JWT_REFRESH_EXPIRATION=7d

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Inquiry delivery - Twilio WhatsApp
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
SENIOR_WHATSAPP=whatsapp:+918788726752

# Inquiry delivery - Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-gmail-address
SMTP_PASS=replace-with-gmail-app-password
MAIL_FROM=replace-with-from-address
MAIL_FROM_NAME=Prezenti
MAIL_TO=replace-with-admin-mailbox
