# Presenti Server - Environment Configuration
# Copy this file to .env and fill in local or deployment values.

# Required: PostgreSQL database used by Prisma.
DATABASE_URL=postgresql://postgres:password@localhost:5432/presenti_db?schema=public

# Required: JWT signing secret used by the auth module.
JWT_SECRET=change-this-to-a-long-random-secret

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-if-refresh-tokens-are-enabled
JWT_REFRESH_EXPIRATION=7d

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
